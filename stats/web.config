<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hébergement Aruba = IIS : les fichiers .htaccess sont ignorés.
  Interdit tout accès HTTP au dossier stats/data/ (base SQLite + journaux WAL)
  et aux fichiers .sqlite, où qu'ils soient sous stats/.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="data" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".sqlite-wal" allowed="false" />
          <add fileExtension=".sqlite-shm" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
